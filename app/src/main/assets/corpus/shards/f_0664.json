,"lastUpdateTime":1738793170995,"bookSourceComment":"//Powered by RosiaP'ng\n\nfunction decoderosiapng(dd) {\n  // Step 1: Decode the input data\n  let decodedData = CryptoJS.enc.Base64.parse(dd).toString(CryptoJS.enc.Utf8);;\n  // Step 2: Calculate the offset and determine the start and end positions\n  let offset = Number(decodedData.slice(8, 11));\n  let start = offset + 11;\n  let end = decodedData.length - offset;\n  // Step 3: Check if start is less than end, to avoid invalid slicing\n  if (start < end) {\n    // Step 4: Process the data by replacing characters\n    let processedData = decodedData\n      .slice(start, end)\n      .replace(/_/g, \"8L3A+\")\n      .replace(/-/g, \"PHA+\");\n    // Step 5: Decode the processed data\n    return CryptoJS.enc.Base64.parse(processedData).toString(CryptoJS.enc.Utf8);;\n  }\n  // If the condition is not met, return null or handle it as needed\n  return null;\n}\n","respondTime":20530,"ruleBookInfo":{"tocUrl":"//div[@class=\"bookbtn\"]/a[contains(.,\"章节目录\")]/@href"},"ruleContent":{"content":"<js>\neval(String(source.bookSourceComment))\nlet regex = /var c=\"([^\"]*)\"/;\nlet dd = result.match(regex)[1]\n\nbelow =decoderosiapng(dd)\n\nvar regex1 = /<div class=\"content\" id=\"chaptercontent\">([\\s\\S]*?)<script>/; // Match up to the <script> tag\nvar top = result.match(regex1)[1]\n\nresult = top + below\n</js>\n//p/text()\n\n\n","nextContentUrl":"@js:\nvar regex2 = /const next_page = \"(\\/[^\"]+)\"/; // Matches the value inside quotes for next_page\nvar n = result.match(regex2)[1]\n\n if (n.includes('_')) {\n    result = 'http://www.xinjianpan.com' + n\n  } "},"ruleExplore":{},"ruleSearch":{"bookList":"//div[@class=\"content pc-pl pc-pr\"]/dl","name":"//dt/a/text()","author":"//dd[2]/a/text()","intro":"//dd[1]/text()","bookUrl":"//dt/a/@href","coverUrl":"//img/@data-src"},"ruleToc":{"chapterList":"//div[@class=\"all\"]/ul/li","chapterName":"//a/text()","chapterUrl":"//a/@onclick\n<js>\n\nvar uu = result.split(\"='\")[